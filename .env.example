# Database
DATABASE_URL=postgresql://user:password@host/dbname

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback

# OpenAI
OPENAI_API_KEY=sk-...

# Sentry — error monitoring, tracing, session replay, logs
NEXT_PUBLIC_SENTRY_DSN=https://...@oNNNNN.ingest.us.sentry.io/NNNN
SENTRY_DSN=https://...@oNNNNN.ingest.us.sentry.io/NNNN
SENTRY_ORG=bitwage
SENTRY_PROJECT=ai-sdr
# Source map upload (gitignored in .env.sentry-build-plugin; required at build time)
SENTRY_AUTH_TOKEN=sntrys_...

# Resend — campaign + workflow email sending
RESEND_API_KEY=re_********
# From address: "Display Name <local@verified-subdomain.example.com>"
# IMPORTANT: use a verified subdomain (mail.example.com), not your apex domain
RESEND_FROM_EMAIL="Scott <scott@mail.example.com>"
# Optional: where replies should land (often differs from sending subdomain)
# RESEND_REPLY_TO=scott@example.com
