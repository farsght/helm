# Database
DATABASE_URL=postgresql://user:password@host/dbname

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# OpenAI
OPENAI_API_KEY=

# Fireflies
FIREFLIES_API_KEY=

# Connections — AES-256-GCM encryption key for stored credentials
# Generate with: openssl rand -base64 32
CONNECTIONS_ENCRYPTION_KEY=

# Inngest — durable pipeline execution
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=1  # set to 1 for local dev, remove in production

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback

# Resend — campaign + workflow email sending
RESEND_API_KEY=
RESEND_FROM_EMAIL="Scott <scott@mail.example.com>"

# Sentry — error monitoring, tracing, session replay, logs
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=helm-gs
SENTRY_PROJECT=helm
SENTRY_AUTH_TOKEN=
