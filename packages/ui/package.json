{
  "name": "@farsight/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./theme.css": "./src/styles/theme.css",
    "./styles/globals.css": "./src/styles/globals.css",
    "./lib/*": "./src/lib/*.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./theme.css": "./dist/styles/theme.css",
      "./styles/globals.css": "./dist/styles/globals.css",
      "./lib/*": "./dist/lib/*.js"
    }
  },
  "scripts": {
    "build": "tsdown -c tsdown.config.ts && mkdir -p dist/styles && cp src/styles/theme.css dist/styles/theme.css && cp src/styles/globals.css dist/styles/globals.css",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@farsight/contracts": "workspace:*",
    "@farsight/sdk": "workspace:*",
    "@radix-ui/react-direction": "^1.1.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "lucide-react": "^1.17.0",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^29.1.1",
    "publint": "0.3.21",
    "rollup-preserve-directives": "1.1.3",
    "tsdown": "0.22.1",
    "vitest": "^4.1.7",
    "vitest-axe": "^0.1.0"
  },
  "peerDependencies": {
    "@clerk/react": "^6.0.0",
    "@dnd-kit/core": "^6.0.0",
    "@dnd-kit/modifiers": "^6.0.0",
    "@dnd-kit/sortable": "^7.0.0",
    "@dnd-kit/utilities": "^3.0.0",
    "@radix-ui/react-direction": "^1.0.0",
    "@radix-ui/react-slot": "^1.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@xyflow/react": "^12.0.0",
    "cmdk": "^1.0.0",
    "next-themes": "^0.4.0",
    "react": "^19.0.0",
    "react-day-picker": "^8.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.0.0",
    "sonner": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@clerk/react": {
      "optional": true
    },
    "@dnd-kit/core": {
      "optional": true
    },
    "@dnd-kit/modifiers": {
      "optional": true
    },
    "@dnd-kit/sortable": {
      "optional": true
    },
    "@dnd-kit/utilities": {
      "optional": true
    },
    "@radix-ui/react-direction": {
      "optional": true
    },
    "@radix-ui/react-slot": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "@xyflow/react": {
      "optional": true
    },
    "cmdk": {
      "optional": true
    },
    "next-themes": {
      "optional": true
    },
    "react-day-picker": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "sonner": {
      "optional": true
    }
  }
}
