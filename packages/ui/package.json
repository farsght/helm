{
  "name": "@farsight/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./theme.css": "./src/styles/theme.css",
    "./styles/globals.css": "./src/styles/globals.css",
    "./lib/*": "./src/lib/*.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./theme.css": "./dist/styles/theme.css",
      "./styles/globals.css": "./dist/styles/globals.css",
      "./lib/*": "./dist/lib/*.js"
    }
  },
  "scripts": {
    "build": "tsdown -c tsdown.config.ts && mkdir -p dist/styles && cp src/styles/theme.css dist/styles/theme.css && cp src/styles/globals.css dist/styles/globals.css"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.2",
    "publint": "0.3.21",
    "rollup-preserve-directives": "1.1.3",
    "tsdown": "0.22.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@clerk/react": "^6.0.0",
    "@xyflow/react": "^12.0.0",
    "@tanstack/react-query": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@clerk/react": {
      "optional": true
    },
    "@xyflow/react": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    }
  }
}
